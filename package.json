{
  "name": "tracebound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first incident investigation agent for the Open Agent Hackathon 2026.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "sample": "tsx src/cli.ts --mode sample --scenario data/sample/scenario.json --output output/sample-run.json",
    "demo:video": "node demo/build-video.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
