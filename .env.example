# Never commit real credentials. Sample mode needs none of these values.
TRACEBOUND_MODE=sample

# Zetaris REST API data layer (live mode only)
ZETARIS_BASE_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=org1
ZETARIS_API_KEY=replace-with-your-zetaris-api-key
ZETARIS_SQL=SELECT * FROM incident_evidence

# Meterless Nightshift OpenAI-compatible runtime (live mode only)
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_RUNTIME_TOKEN=replace-with-your-nightshift-runtime-token
NIGHTSHIFT_MODEL=meterless/auto
NIGHTSHIFT_APP=tracebound
NIGHTSHIFT_SCOPE=user
